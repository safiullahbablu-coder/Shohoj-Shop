rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidId(orderId);
      allow update, delete: if isValidId(orderId);
    }

    match /chat_messages/{messageId} {
      allow read: if true;
      allow create: if isValidId(messageId);
      allow update, delete: if isValidId(messageId);
    }

    // Health / connection check collection
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
